# Set these variables in your .env.local file

# Required: Your AI provider API key. (e.g. OpenAI API Key, Gemini API Key, etc.)
AI_API_KEY="your-api-key-here"

# Optional: Base URL for OpenAI compatible endpoints. 
# For Gemini, use: https://generativelanguage.googleapis.com/v1beta/openai/
# For OpenAI, you can leave it blank.
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# Optional: The language model to use (default: gpt-4o)
# For Gemini, try: gemini-2.5-pro or gemini-2.5-flash
AI_MODEL="gemini-2.5-pro"

# Optional: The embedding model to use (default: text-embedding-3-small)
# For Gemini, try: text-embedding-004
AI_EMBEDDING_MODEL="text-embedding-004"
